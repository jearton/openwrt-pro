#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

start_service() {
	. /lib/functions/network.sh

	local address directory
	network_get_ipaddr address lan || return 0
	for directory in /var/cache/netdata /var/lib/netdata /var/log/netdata; do
		mkdir -p "$directory" || return 1
		chown netdata:netdata "$directory" || return 1
	done

	procd_open_instance
	procd_set_param command /opt/netdata/bin/srv/netdata -D -c /etc/netdata/netdata.conf -i "$address:19999"
	procd_set_param user netdata
	procd_set_param env DISABLE_TELEMETRY=1
	procd_set_param file /etc/netdata/netdata.conf
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_interface_trigger "interface.*" lan /etc/init.d/netdata restart
}
