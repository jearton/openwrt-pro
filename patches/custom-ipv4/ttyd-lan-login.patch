diff --git a/utils/ttyd/files/ttyd-login b/utils/ttyd/files/ttyd-login
new file mode 100644
index 0000000..0f43984
--- /dev/null
+++ b/utils/ttyd/files/ttyd-login
@@ -0,0 +1,9 @@
+#!/bin/sh
+
+# A fresh OpenWrt image permits an empty root password at the console.
+if ! awk -F: '$1 == "root" && $2 != "" && $2 !~ /^[!*]/ { found = 1 } END { exit !found }' /etc/shadow; then
+	printf '%s\n' 'Set a root password in LuCI (System > Administration), then reopen Terminal.'
+	exit 1
+fi
+
+exec /bin/login root
