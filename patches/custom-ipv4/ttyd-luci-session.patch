+@@ -0,0 +1,72 @@
++#include <libubus.h>
++#include <libwebsockets.h>
++#include <string.h>
++
++#include "server.h"
++
++static bool luci_session_cookie(const char *header, const char *name, char sid[33]) {
++  const size_t name_len = strlen(name);
++  bool found = false;
++
++  while (*header) {
++    header += strspn(header, " \t");
++    const char *next = strchr(header, ';');
++    const char *end = next ? next : header + strlen(header);
++    while (end > header && (end[-1] == ' ' || end[-1] == '\t')) end--;
++
++    if ((size_t)(end - header) > name_len && !strncmp(header, name, name_len) && header[name_len] == '=') {
++      const char *value = header + name_len + 1;
++      if (found || end - value != 32 || strspn(value, "0123456789abcdef") != 32 ||
++          !strncmp(value, "00000000000000000000000000000000", 32))
++        return false;
++
++      memcpy(sid, value, 32);
++      sid[32] = '\0';
++      found = true;
++    }
++
++    if (!next) break;
++    header = next + 1;
++  }
++
++  return found;
++}
++
++static void access_reply(struct ubus_request *req, int type, struct blob_attr *msg) {
++  static const struct blobmsg_policy policy[] = {{ .name = "access", .type = BLOBMSG_TYPE_BOOL }};
++  struct blob_attr *attrs[ARRAY_SIZE(policy)] = {};
++
++  if (!msg) return;
++  blobmsg_parse(policy, ARRAY_SIZE(policy), attrs, blob_data(msg), blob_len(msg));
++  *(bool *)req->priv = attrs[0] && blobmsg_get_bool(attrs[0]);
++}
++
++bool luci_session_allowed(const char *sid) {
++  struct ubus_context *ctx = ubus_connect(NULL);
++  struct blob_buf request = {};
++  uint32_t object;
++  bool access = false;
++
++  if (!ctx) return false;
++  if (ubus_lookup_id(ctx, "session", &object) == UBUS_STATUS_OK &&
++      blob_buf_init(&request, 0) == 0) {
++    blobmsg_add_string(&request, "ubus_rpc_session", sid);
++    blobmsg_add_string(&request, "scope", "access-group");
++    blobmsg_add_string(&request, "object", "luci-app-ttyd");
++    blobmsg_add_string(&request, "function", "write");
++    if (ubus_invoke(ctx, object, "access", request.head, access_reply, &access, 250) != UBUS_STATUS_OK)
++      access = false;
++  }
++
++  blob_buf_free(&request);
++  ubus_free(ctx);
++  return access;
++}
++
++bool luci_session_check(struct lws *wsi, char sid[33]) {
++  char cookie[2048];
++  const char *name = lws_is_ssl(wsi) ? "sysauth_https" : "sysauth_http";
++
++  return lws_hdr_copy(wsi, cookie, sizeof(cookie), WSI_TOKEN_HTTP_COOKIE) > 0 &&
++         luci_session_cookie(cookie, name, sid) && luci_session_allowed(sid);
++}
