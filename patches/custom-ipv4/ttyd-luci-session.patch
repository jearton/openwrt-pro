+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-or-later
+
+if ! awk -F: '$1 == "root" && $2 != "" && $2 !~ /^[!*]/ { ready = 1 } END { exit !ready }' /etc/shadow; then
+	printf '%s\n' 'Set a system password in LuCI before using the terminal.'
