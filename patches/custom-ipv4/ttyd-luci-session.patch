+# uHTTPd creates DER certificates; libwebsockets expects PEM files.
+# Normalize into a private runtime directory and leave configured originals intact.
+luci_tls_pem() {
+	local source_cert="$1" source_key="$2" instance="$3"
+	local directory=/var/run/ttyd-luci
+	local prefix="$directory/$instance"
+	(
+		umask 077
+		mkdir -p "$directory" && chmod 700 "$directory" || exit 1
+		trap 'rm -f "$prefix.crt.new" "$prefix.key.new"' EXIT
+		openssl x509 -in "$source_cert" -out "$prefix.crt.new" 2>/dev/null ||
+			openssl x509 -inform DER -in "$source_cert" -out "$prefix.crt.new" || exit 1
+		openssl pkey -in "$source_key" -passin pass: -out "$prefix.key.new" 2>/dev/null ||
+			openssl pkey -inform DER -in "$source_key" -passin pass: -out "$prefix.key.new" || exit 1
+		mv "$prefix.crt.new" "$prefix.crt" && mv "$prefix.key.new" "$prefix.key" || exit 1
+	)
+}
