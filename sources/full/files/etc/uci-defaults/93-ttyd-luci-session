#!/bin/sh
set -e

section='ttyd.@ttyd[0]'
command="$(uci -q get "$section.command")" || exit 0
case "$command" in
'/bin/ash -l'|/bin/login|/usr/libexec/ttyd-login)
	uci set "$section.command=/usr/libexec/ttyd-login"
	uci set "$section.luci_auth=1"
	uci set "$section.check_origin=1"
	uci commit ttyd
	;;
esac
