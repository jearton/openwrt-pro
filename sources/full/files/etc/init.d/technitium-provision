#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-or-later

START=45
STOP=15
USE_PROCD=1

start_service() {
	[ ! -e /etc/technitium/provisioned ] || return 0
	procd_open_instance
	procd_set_param command /usr/libexec/technitium-provision
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
